# Copie ce fichier en .env (déjà ignoré par git) et colle tes clés.
# Ordre d'essai : Groq → Deepgram → Whisper → Gemini. Seul Groq est indispensable pour démarrer ;
# les autres ne servent qu'en secours si Groq est indisponible ou limité.

# Clé API Groq — gratuite, à créer sur https://console.groq.com/keys
GROQ_API_KEY=

# Clé API Deepgram (secours) — crédit d'essai gratuit, https://console.deepgram.com
DEEPGRAM_API_KEY=

# Clé API OpenAI (dernier recours) — payant à la minute, https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Clé API Google Gemini (secours, dictée simple uniquement — pas utilisée pour les
# réunions, qui ont besoin de vocabulaire ET de diarisation en même temps, ce que
# Gemini 3.5 Transcribe ne permet pas de combiner) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
